# ============================================
# SIGNATUS Backend — Environment Configuration
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git or share it publicly.

# ----- Server -----
PORT=3000

# ----- The atelier inbox (where messages will be delivered) -----
# This is hidden server-side and never sent to the browser.
ATELIER_EMAIL=wnq.offical@gmail.com

# ----- SMTP credentials (the account that SENDS the email) -----
# Recommended: use the same Gmail account with an App Password (see GUIDE.md).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=wnq.offical@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ----- CORS: which websites are allowed to call this backend -----
# Comma-separated. Include your production domain and (optionally) localhost for testing.
# Leave empty during initial development to allow all origins.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,https://your-domain.com
